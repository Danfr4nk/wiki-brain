#!/usr/bin/env python3
"""wiki-lexicon — the personal lexicon: the words, measured.

Why this exists
---------------
`wiki/interests/language/vocabulary-lexicon` records 200 words Dan *selected*
as pleasing. `wiki/interests/language/personal-lexicon` records ~25 terms an
assistant *recalled* him using — and its central term turned out not to exist
in the archive at all. Both are lexicons nobody counted.

This is the counting. It reads Dan's own first-party text in two registers —
what he types to people, and what he types to models — and reports which words
actually mark his speech, at what rate, in which year, against a contrast
corpus rather than against an impression.

The three traps, and how they are handled
-----------------------------------------
1. **One corpus is not the corpus, and the two are in different time zones.**
   The iMessage dump reaches 2025 and stops; the deep CSV export reaches 2026
   but is thin on 2024. Neither alone covers the record. `load_texting()` reads
   both through their existing readers — `bin/mine-messages` and
   `bin/text-metrics`, imported rather than reimplemented, so their
   normalisation and traps come with them.

   **The dump is US Eastern local time and the deep CSV is UTC.** Measured on
   60,495 messages present in both: 36,716 differ by exactly +4h (EDT) and
   23,624 by +5h (EST). A union keyed on the timestamp therefore matches
   nothing and silently doubles the corpus — the first run of this tool
   reported 188,445 sent messages against the dump's 106,629. CSV timestamps
   are converted to `America/New_York` before use, and deduplication matches
   on (direction, normalised text) with a ±6h window so a genuinely repeated
   short message later the same day still counts twice. A repeat of the same
   short text *within* six hours is dropped as a duplicate; that is the known
   cost of the window and it falls on "ok" and "yeah", not on vocabulary.
2. **Distinctiveness needs a contrast corpus.** A raw frequency list is a list
   of function words. Everything here is scored by log-odds-ratio with an
   informative Dirichlet prior (Monroe, Colaresi & Quinn 2008) against a
   contrast: Dan's sent text against everything he received, or his texting
   against his AI prompts. The score is a z-statistic, so a small count cannot
   outrank a large one on ratio alone.
3. **A rate is meaningless without its denominator.** Every figure this tool
   prints carries the token count it was computed from. Follows
   `bin/intake`'s rule: a rate over part of the record must not be able to look
   like a rate over all of it.

Subcommands
-----------
  probe WORD...        per-year rate for a word or phrase, both registers
  distinctive          what marks Dan's speech against his interlocutors'
  registers            texting vs AI-prompt density for a wordlist or a page
  mine                 recompute lexicon/measured.json (slow, ~60s)
  pending              captured words in lexicon/words/ awaiting a reading
  show ID              one captured word
  page                 regenerate the public measured-vocabulary page
  check                gate: pending captures, projection and page drift
"""
import argparse
import glob
import json
import math
import os
import re
import sys
import datetime
import html as htmlmod
from collections import Counter, defaultdict
from importlib.machinery import SourceFileLoader
from zoneinfo import ZoneInfo

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WORDS = os.path.join(ROOT, "lexicon", "words")
MEASURED = os.path.join(ROOT, "lexicon", "measured.json")
PAGE = os.path.join(ROOT, "wiki", "interests", "language", "measured-vocabulary.md")
CHATGPT = os.path.join(ROOT, "raw", "self", "chatgpt-export",
                       "dfrank-chatgpt-conversations-2022-2025.json")
GEMINI = os.path.join(ROOT, "raw", "self", "gemini-activity", "Gemini Activity.html")
# Each Takeout activity cell opens `Prompted&nbsp;<his text><br><date>`. The
# date is the boundary between what he wrote and what the model answered.
GEMINI_PROMPT = r'content-cell[^>]*>Prompted\xa0(.*?)<br>\s*[A-Z][a-z]{2} \d{1,2}, \d{4}'

TOKEN = re.compile(r"[a-z][a-z'\-]*")
GENERATED = "<!-- generated by bin/wiki-lexicon page — do not hand-edit -->"

# A year needs this many of Dan's tokens before its rates are printed as a
# series. 2021 has 259 rows in one export and 1,465 records in the other;
# a per-10k rate off that base is noise wearing a decimal point.
MIN_YEAR_TOKENS = 20_000

# The dump is Eastern local, the deep CSV is UTC. See the module docstring:
# without this conversion the union double-counts every shared message.
UTC = ZoneInfo("UTC")
EASTERN = ZoneInfo("America/New_York")
DEDUPE_WINDOW_S = 6 * 3600

# The four series the generated page charts. Chosen because they are the four
# steepest monotone movers in the corpus and they move in opposite directions:
# the abbreviation dies while the intensifier and the stance adverb climb.
# The terms `wiki/interests/language/personal-lexicon` is built on. Counted in
# every corpus that can be split by voice, because a corpus-wide count over a
# transcript counts the model quoting him back and reads as his usage.
CLUSTER_TERMS = [
    "recursive cognitive prosthetic", "cognitive prosthetic",
    "recursive symbolic architect", "symbolic architect",
    "emotional metabolizer", "emotional metabolizing", "taboo-mining",
    "co-processor", "daemon mirror", "emotional debugger", "ideation engine",
    "recursive", "epistemic", "exocortex",
]

CHART_SERIES = [
    ("u", "u (for 'you')"),
    ("lol", "lol"),
    ("fucking", "fucking"),
    ("literally", "literally"),
]


def _load_module(name, path):
    return SourceFileLoader(name, os.path.join(ROOT, "bin", path)).load_module()


def norm(s):
    """Fold to the matching form. Delegates to mine-messages so the curly-quote
    trap is handled in exactly one place in this repository."""
    mm = _load_module("mm", "mine-messages")
    return mm.norm(s)


def load_texting():
    """Every message Dan sent or received, from both exports, deduplicated.

    Yields dicts: date, time, dir, text, src. Neither export covers the record
    on its own — see the module docstring — so this is the union, and `src`
    records which export a row came from so the seam can be measured rather
    than assumed. CSV rows are converted from UTC to Eastern local first;
    without that the two exports never match and every shared message is
    counted twice.
    """
    mm = _load_module("mm", "mine-messages")
    index = defaultdict(list)
    for r in mm.records():
        try:
            ts = datetime.datetime.strptime(r["date"] + " " + r["time"], "%Y-%m-%d %H:%M:%S")
        except ValueError:
            continue
        index[(r["dir"], norm(r["text"]).strip())].append(ts)
        yield {"date": r["date"], "time": r["time"], "dir": r["dir"],
               "text": r["text"], "src": "dump"}

    tm = _load_module("tm", "text-metrics")
    for r in tm.load():
        local = r["ts"].replace(tzinfo=UTC).astimezone(EASTERN)
        key = (r["dir"], norm(r["text"]).strip())
        if any(abs((local.replace(tzinfo=None) - seen).total_seconds()) <= DEDUPE_WINDOW_S
               for seen in index.get(key, ())):
            continue
        index[key].append(local.replace(tzinfo=None))
        yield {"date": local.strftime("%Y-%m-%d"), "time": local.strftime("%H:%M:%S"),
               "dir": r["dir"], "text": r["text"], "src": "csv"}


def load_ai_prompts(source="chatgpt"):
    """Dan's own turns from an AI export — the second register, by platform.

    `chatgpt` takes only `author.role == "user"` parts from the conversations
    JSON, so it is his prose and never a model's.

    `gemini` parses the Takeout activity HTML, where each cell is
    `Prompted&nbsp;<his text><br><date><br><the model's reply>`. Splitting on
    that boundary is the only way to count this corpus honestly: a raw grep
    over the file counts both voices, and the model quotes his vocabulary back
    at him constantly. `cognitive prosthetic` occurs 29 times in his prompts
    and 100 times in the replies; a corpus-wide count of 129 would read as his
    usage and be wrong by a factor of four.

    **The Gemini caveat, which does not go away.** His Gemini prompts average
    ~1,186 characters against ChatGPT's ~422, because he pastes documents into
    them — bootloaders, profile texts, exports. So this corpus is his prose
    *plus* material he chose to paste, and the two cannot be separated
    mechanically. It is first-party in the sense that he put it there, not in
    the sense that he typed every word. Reported as its own register for that
    reason, never merged into the ChatGPT one.
    """
    if source == "chatgpt":
        if not os.path.exists(CHATGPT):
            return []
        convs = json.load(open(CHATGPT, encoding="utf-8"))
        out = []
        for c in convs:
            for node in (c.get("mapping") or {}).values():
                msg = node.get("message")
                if not msg or (msg.get("author") or {}).get("role") != "user":
                    continue
                for part in (msg.get("content") or {}).get("parts") or []:
                    if isinstance(part, str) and part.strip():
                        out.append(part)
        return out

    if source == "gemini":
        if not os.path.exists(GEMINI):
            return []
        raw = open(GEMINI, encoding="utf-8", errors="replace").read()
        cells = re.findall(GEMINI_PROMPT, raw, re.S)
        return [htmlmod.unescape(re.sub(r"<[^>]+>", " ", c)).strip() for c in cells]

    raise ValueError(source)


def logodds(a, b, min_count):
    """Monroe et al. log-odds ratio with an informative Dirichlet prior.

    Returns (z, word, count_a, count_b) sorted by z descending. The prior is
    the pooled count, which is what keeps a word Dan used 61 times and nobody
    else used at all from outranking one he used 4,000 times at twice the
    rate: the variance term grows as the counts shrink.
    """
    na, nb = sum(a.values()), sum(b.values())
    total = na + nb
    out = []
    for w, ca in a.items():
        if ca < min_count:
            continue
        cb = b.get(w, 0)
        prior = ca + cb
        delta = (math.log((ca + prior) / (na + total - ca - prior))
                 - math.log((cb + prior) / (nb + total - cb - prior)))
        var = 1.0 / (ca + prior) + 1.0 / (cb + prior)
        out.append((delta / math.sqrt(var), w, ca, cb))
    out.sort(reverse=True)
    return out


def ngrams(tokens, n):
    return zip(*(tokens[i:] for i in range(n))) if n > 1 else ((t,) for t in tokens)


# ---------------------------------------------------------------- subcommands

def cmd_mine(a):
    sent_n = [Counter(), Counter(), Counter()]      # uni, bi, tri
    recv_n = [Counter(), Counter(), Counter()]
    per_year = defaultdict(Counter)
    year_tokens = Counter()
    first_seen = {}
    src_rows = Counter()
    sent_msgs = recv_msgs = 0
    _sent_texts_cache = []

    for r in load_texting():
        toks = TOKEN.findall(norm(r["text"]).lower())
        if not toks:
            continue
        src_rows[r["src"]] += 1
        target = sent_n if r["dir"] == "Sent" else recv_n
        if r["dir"] == "Sent":
            sent_msgs += 1
            _sent_texts_cache.append(norm(r["text"]).lower())
            year = r["date"][:4]
            per_year[year].update(toks)
            year_tokens[year] += len(toks)
            for w in set(toks):
                if w not in first_seen or r["date"] < first_seen[w]:
                    first_seen[w] = r["date"]
        else:
            recv_msgs += 1
        for i in range(3):
            target[i].update(" ".join(g) for g in ngrams(toks, i + 1))

    ai_reg = {}
    for src in ("chatgpt", "gemini"):
        turns = load_ai_prompts(src)
        c = Counter(TOKEN.findall(norm("\n".join(turns)).lower()))
        ai_reg[src] = {"counts": c, "turns": len(turns)}
    ai_counts = ai_reg["chatgpt"]["counts"]

    thresholds = [60, 30, 20]
    out = {
        "meta": {
            "sent_messages": sent_msgs,
            "received_messages": recv_msgs,
            "sent_tokens": sum(sent_n[0].values()),
            "received_tokens": sum(recv_n[0].values()),
            "ai_prompt_tokens": sum(ai_counts.values()),
            "ai_prompt_turns": ai_reg["chatgpt"]["turns"],
            "gemini_prompt_tokens": sum(ai_reg["gemini"]["counts"].values()),
            "gemini_prompt_turns": ai_reg["gemini"]["turns"],
            "rows_by_source": dict(src_rows),
            "min_year_tokens": MIN_YEAR_TOKENS,
        },
        "distinctive": {},
        "register": [],
        "years": {},
    }
    for i, kind in enumerate(("unigram", "bigram", "trigram")):
        rows = logodds(sent_n[i], recv_n[i], thresholds[i])[:200]
        out["distinctive"][kind] = [
            {"z": round(z, 2), "term": w, "dan": ca, "others": cb,
             "first_seen": first_seen.get(w) if i == 0 else None}
            for z, w, ca, cb in rows]

    reg = logodds(ai_counts, sent_n[0], 25)[:120]
    out["register"] = [{"z": round(z, 2), "term": w, "ai": ca, "texting": cb}
                       for z, w, ca, cb in reg]
    # The lexicon's own terms, counted in every corpus that can be split by
    # voice. Exact-term matching only: a *ranked word list* over the Gemini
    # prompts is worthless, because he pastes documents into them and the top
    # of that list comes back `div`, `class`, `null`, `data-v-`, `path`. An
    # exact match on "cognitive prosthetic" is immune to that contamination;
    # a frequency ranking is not, so this tool computes the first and refuses
    # the second.
    out["cluster"] = {}
    blobs = {
        "texting": "\n".join(_sent_texts_cache),
        "chatgpt_prompts": norm("\n".join(load_ai_prompts("chatgpt"))).lower(),
        "gemini_prompts": norm("\n".join(load_ai_prompts("gemini"))).lower(),
    }
    out["cluster_chars"] = {k: len(v) for k, v in blobs.items()}
    for term in CLUSTER_TERMS:
        pat = re.compile((r"\b" + re.escape(term) + r"\b") if " " not in term
                         else re.escape(term))
        out["cluster"][term] = {k: len(pat.findall(v)) for k, v in blobs.items()}

    for year, counts in sorted(per_year.items()):
        if year_tokens[year] < MIN_YEAR_TOKENS:
            continue
        out["years"][year] = {
            "tokens": year_tokens[year],
            "top": dict(counts.most_common(3000)),
        }

    os.makedirs(os.path.dirname(MEASURED), exist_ok=True)
    json.dump(out, open(MEASURED, "w"), indent=1, sort_keys=True)
    m = out["meta"]
    print(f"wiki-lexicon mine: {m['sent_messages']:,} sent / "
          f"{m['received_messages']:,} received messages, "
          f"{m['sent_tokens']:,} of Dan's texting tokens, "
          f"{m['ai_prompt_tokens']:,} AI-prompt tokens "
          f"-> {os.path.relpath(MEASURED, ROOT)}")
    return 0


def _measured():
    if not os.path.exists(MEASURED):
        sys.exit("wiki-lexicon: no lexicon/measured.json — run `bin/wiki-lexicon mine`")
    return json.load(open(MEASURED))


def cmd_probe(a):
    """Per-year rate for a word or phrase in Dan's own text."""
    terms = [t.lower() for t in a.terms]
    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b") for t in terms}
    years = defaultdict(Counter)
    year_tokens = Counter()
    ai_hits = Counter()
    for r in load_texting():
        if r["dir"] != "Sent":
            continue
        t = norm(r["text"]).lower()
        year_tokens[r["date"][:4]] += len(TOKEN.findall(t))
        for term, p in pats.items():
            n = len(p.findall(t))
            if n:
                years[r["date"][:4]][term] += n
    ai_text = norm("\n".join(load_ai_prompts())).lower()
    ai_tokens = len(TOKEN.findall(ai_text))
    for term, p in pats.items():
        ai_hits[term] = len(p.findall(ai_text))

    shown = sorted(y for y in year_tokens if year_tokens[y] >= MIN_YEAR_TOKENS)
    print("Rate per 10,000 of Dan's own tokens. Years under "
          f"{MIN_YEAR_TOKENS:,} tokens are omitted, not zero.\n")
    head = f"{'term':<26}{'total':>7}" + "".join(f"{y[2:]:>8}" for y in shown) + f"{'AI':>9}"
    print(head)
    print("-" * len(head))
    for term in terms:
        total = sum(years[y][term] for y in years)
        row = "".join(f"{years[y][term] / year_tokens[y] * 10000:8.1f}" for y in shown)
        ai = f"{ai_hits[term] / ai_tokens * 10000:9.1f}" if ai_tokens else "        -"
        print(f"{term:<26}{total:>7}{row}{ai}")
    print(f"\ntokens/year: " + "  ".join(f"{y}={year_tokens[y]:,}" for y in shown))
    print(f"AI-prompt tokens: {ai_tokens:,}")
    return 0


def cmd_distinctive(a):
    d = _measured()
    rows = d["distinctive"][a.kind][:a.n]
    m = d["meta"]
    print(f"What marks Dan's speech against the {m['received_messages']:,} messages he "
          f"received.\nLog-odds z, informative Dirichlet prior. "
          f"{m['sent_tokens']:,} of his tokens against {m['received_tokens']:,} of theirs.\n")
    print(f"{'z':>7}  {'term':<32}{'Dan':>8}{'others':>8}")
    for r in rows:
        print(f"{r['z']:7.1f}  {r['term']:<32}{r['dan']:>8}{r['others']:>8}")
    return 0


def cmd_registers(a):
    """Density of a wordlist in each of Dan's two first-party registers."""
    if a.page:
        text = open(os.path.join(ROOT, a.page), encoding="utf-8").read()
        words = sorted({m.group(1).strip().lower()
                        for m in re.finditer(r"^\d+\.\s+([A-Za-z][A-Za-z\- ]{2,30})\s*$",
                                             text, re.M)
                        if " " not in m.group(1).strip()})
        label = a.page
    else:
        words = sorted({w.lower() for w in a.words})
        label = f"{len(words)} word(s) given"
    if not words:
        sys.exit("wiki-lexicon registers: no words found")

    texting = Counter()
    for r in load_texting():
        if r["dir"] == "Sent":
            texting.update(TOKEN.findall(norm(r["text"]).lower()))
    ai = Counter(TOKEN.findall(norm("\n".join(load_ai_prompts())).lower()))
    nt, na = sum(texting.values()), sum(ai.values())

    t_hits = {w: texting[w] for w in words if texting[w]}
    a_hits = {w: ai[w] for w in words if ai[w]}
    t_sum, a_sum = sum(t_hits.values()), sum(a_hits.values())
    print(f"{label}: {len(words)} single words\n")
    print(f"  texting    {len(t_hits):>3}/{len(words)} present, {t_sum:>5} occurrences "
          f"in {nt:,} tokens = {t_sum / nt * 10000:.2f} per 10k")
    print(f"  AI prompts {len(a_hits):>3}/{len(words)} present, {a_sum:>5} occurrences "
          f"in {na:,} tokens = {a_sum / na * 10000:.2f} per 10k")
    if t_sum and nt and na:
        print(f"  ratio      {(a_sum / na) / (t_sum / nt):.2f}x denser in AI prompts")
    print("\n  absent from both registers "
          f"({len([w for w in words if not texting[w] and not ai[w]])}): "
          + ", ".join(w for w in words if not texting[w] and not ai[w])[:400])
    return 0


def captures():
    out = []
    for path in sorted(glob.glob(os.path.join(WORDS, "*.md"))):
        text = open(path, encoding="utf-8").read()
        m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
        fm = {}
        if m:
            for line in m.group(1).split("\n"):
                if ":" in line and not line.startswith((" ", "-")):
                    k, _, v = line.partition(":")
                    fm[k.strip()] = v.strip().strip('"')
        out.append({"path": os.path.relpath(path, ROOT), "fm": fm, "text": text})
    return out


def cmd_pending(a):
    rows = [c for c in captures() if (c["fm"].get("status") or "pending") == "pending"]
    if not rows:
        print(f"wiki-lexicon: 0 pending, {len(captures())} captured word(s) — nothing owed")
        return 0
    print(f"wiki-lexicon: {len(rows)} word(s) awaiting a reading\n")
    for c in rows:
        print(f"  {c['fm'].get('word','?'):<22} {c['fm'].get('added','')[:10]:<12} {c['path']}")
    print("\n  Read one with: bin/wiki-lexicon probe <word>")
    print("  Then write the ## Reading section and set status: analyzed, analyzed: <date>.")
    return 0


def cmd_show(a):
    for c in captures():
        if a.id in c["path"] or a.id == c["fm"].get("word"):
            print(c["text"])
            return 0
    sys.exit(f"wiki-lexicon: no captured word matching {a.id!r}")


def render_page(d):
    m = d["meta"]
    L = []
    A = L.append
    A("---")
    A("domain: interests")
    A("page_type: dataset")
    A('title: "Measured Vocabulary — the words Dan actually uses"')
    A('aliases: ["measured vocabulary", "the distinctive words", "lexicon measurements"]')
    A("status: active")
    A("knowledge: derived")
    A("date_created: 2026-09-05")
    A("date_modified: 2026-09-05")
    A("sources:")
    A("  - raw/self/dox-scan/all_imessages_complete_dump.txt")
    A("  - raw/self/message-csv/imessage_export_deep_20260813.csv")
    A("  - raw/self/chatgpt-export/dfrank-chatgpt-conversations-2022-2025.json")
    A("tags: [language, vocabulary, forensic-analysis]")
    years = sorted(d["years"])
    A("chart:")
    A("  kind: line")
    A('  title: "Dan\'s register drift, 2015-2026 — rate per 10,000 of his own tokens"')
    A('  x: { label: "Year", type: category }')
    A('  y: { label: "Occurrences per 10,000 tokens", type: number }')
    A("  series:")
    for w, label in CHART_SERIES:
        A(f'    - name: "{label}"')
        A("      points:")
        for y in years:
            yd = d["years"][y]
            A(f'        "{y}": {yd["top"].get(w, 0) / yd["tokens"] * 10000:.1f}')
    A("connections:")
    A("  - page: wiki/interests/language/personal-lexicon")
    A("    type: evidences")
    A("    claim: \"This is the measurement that page said the lexicon needed and did not "
      "have: every term scored against a contrast corpus rather than recalled, which is "
      "how the difference between a word Dan uses and a word he liked became checkable.\"")
    A("  - page: wiki/interests/language/vocabulary-lexicon")
    A("    type: evidences")
    A("    claim: \"The curated 'pretty' and 'stupid' batches are measured here against "
      "both of Dan's first-party registers, which settles that page's open question about "
      "whether its words are used: they are not, in either register, and the head of its "
      "own Axis A is the emptiest part of it.\"")
    A("  - page: wiki/mind/synthesis/supply-network")
    A("    type: evidences")
    A("    claim: \"The network's canonical speech act, counted: 'can you stop by' and "
      "its variants run 527 to 62 against everyone Dan has ever texted and 'i'm home on "
      "___' 211 to 0, with 333 of his 442 summons falling in the two hours 17:00-18:59 "
      "and the per-year rate spiking to 17.1 and 19.7 per 10k in 2019 and 2024 alone.\"")
    A("  - page: wiki/mind/profile/linguistic-profile")
    A("    type: evidences")
    A("    claim: \"'Forensic intimacy' turns out to be subordination and to be "
      "countable: 'the fact that' 254 to 34, 'whether or not' 158 to 2, 'that you're' "
      "346 to 17 — roughly six times his interlocutors' rate for embedding a proposition "
      "in a that-clause, and rising across the record rather than holding steady.\"")
    A("  - page: wiki/mind/synthesis/message-circadian-latency")
    A("    type: parallels")
    A("    claim: \"A lexical rhythm that page's hour-of-day cut does not reach: the "
      "supply summons is 442 of Dan's messages, 333 of them (75%) inside the two hours "
      "17:00-18:59 — far tighter than his general circadian profile, and set by somebody "
      "else's shift rather than his own sleep.\"")
    A("  - page: wiki/mind/profile/texting-deviance-audit")
    A("    type: parallels")
    A("    claim: \"That page measures the turn — how long Dan's utterances are against "
      "his interlocutors'. This measures the word inside it, on the same corpus and with "
      "the same contrast, and the two series move together: turns lengthen as the "
      "abbreviations die.\"")
    A("---")
    A("")
    A(GENERATED)
    A("")
    A("# Measured Vocabulary — the words Dan actually uses")
    A("")
    A("**This page is generated. Do not hand-edit it** — run `bin/wiki-lexicon mine` "
      "then `bin/wiki-lexicon page`. It states no finding: it is the arithmetic, and a "
      "conclusion drawn from it reaches an ordinary page through the normal operations.")
    A("")
    A("Every other lexicon in this wiki records words somebody *chose* — the 200 curated "
      "terms on [[wiki/interests/language/vocabulary-lexicon]], the ~25 recalled coinages "
      "on [[wiki/interests/language/personal-lexicon]]. This one records words somebody "
      "*counted*, against a contrast corpus, so that \"distinctive\" means something a "
      "reader can check.")
    A("")
    A("## Coverage")
    A("")
    A("| | |")
    A("|---|---|")
    A(f"| Messages Dan sent | {m['sent_messages']:,} |")
    A(f"| Messages Dan received (the contrast corpus) | {m['received_messages']:,} |")
    A(f"| Dan's texting tokens | {m['sent_tokens']:,} |")
    A(f"| Their tokens | {m['received_tokens']:,} |")
    A(f"| Dan's AI-prompt turns (ChatGPT export, 2022–2025) | {m['ai_prompt_turns']:,} |")
    A(f"| Dan's AI-prompt tokens | {m['ai_prompt_tokens']:,} |")
    A("")
    src = m.get("rows_by_source", {})
    if src:
        A("Rows by export, after deduplication on (date, time, direction, text): "
          + ", ".join(f"**{k}** {v:,}" for k, v in sorted(src.items()))
          + ". Neither export covers the record alone — the dump stops in 2025 and the "
            "CSV is thin on 2024 — so both are read and the union is what is counted.")
        A("")
    A("## What marks his speech")
    A("")
    A("Log-odds ratio with an informative Dirichlet prior, Dan's sent text against "
      "everything he received. The score is a z-statistic, so a rare word cannot outrank "
      "a common one on ratio alone. Counts are raw occurrences.")
    A("")
    for kind, head, n in (("unigram", "Words", 40), ("bigram", "Two-word", 30),
                          ("trigram", "Three-word", 25)):
        A(f"### {head}")
        A("")
        A("| z | term | Dan | others |")
        A("|---:|---|---:|---:|")
        for r in d["distinctive"][kind][:n]:
            A(f"| {r['z']:.1f} | `{r['term']}` | {r['dan']:,} | {r['others']:,} |")
        A("")
    A("## The second register")
    A("")
    A("Dan writes first-party prose in two places the archive can separate: messages to "
      "people, and prompts to models. These are the words that mark the prompts against "
      "the messages — same author, same years, different addressee.")
    A("")
    A("| z | term | AI prompts | texting |")
    A("|---:|---|---:|---:|")
    for r in d["register"][:35]:
        A(f"| {r['z']:.1f} | `{r['term']}` | {r['ai']:,} | {r['texting']:,} |")
    A("")
    A("## The lexicon's own terms, by voice")
    A("")
    A("[[wiki/interests/language/personal-lexicon]] is built on these terms. A "
      "corpus-wide `grep` counts both voices in a transcript and reads as his usage; "
      "these are counted only in text the export can attribute to **him** — his "
      "ChatGPT user turns, and the prompt half of each Gemini activity cell.")
    A("")
    cc = d.get("cluster_chars", {})
    A(f"| term | texting ({cc.get('texting',0):,} chars) | ChatGPT prompts "
      f"({cc.get('chatgpt_prompts',0):,}) | Gemini prompts "
      f"({cc.get('gemini_prompts',0):,}) |")
    A("|---|---:|---:|---:|")
    for term, row in d.get("cluster", {}).items():
        A(f"| `{term}` | {row['texting']} | {row['chatgpt_prompts']} | "
          f"{row['gemini_prompts']} |")
    A("")
    A("**The Gemini column is not clean and cannot be made clean.** His Gemini prompts "
      "average ~1,186 characters against ChatGPT's ~422 because he pastes documents "
      "into them; a ranked word list over that corpus returns `div`, `class`, `null` "
      "and `data-v-` at the top. An exact match on a multi-word term is immune to "
      "that and a frequency ranking is not, which is why this tool computes the first "
      "and refuses the second.")
    A("")
    A("## Rate by year")
    A("")
    A(f"Per 10,000 of Dan's own tokens in that year. A year under "
      f"{m['min_year_tokens']:,} tokens is omitted rather than shown as noise.")
    A("")
    probe = ["u", "you", "lol", "i", "fucking", "literally", "actually",
             "love", "sorry", "think", "know", "gonna"]
    A("| term | " + " | ".join(years) + " |")
    A("|---|" + "---:|" * len(years))
    for w in probe:
        cells = []
        for y in years:
            yd = d["years"][y]
            cells.append(f"{yd['top'].get(w, 0) / yd['tokens'] * 10000:.1f}")
        A(f"| `{w}` | " + " | ".join(cells) + " |")
    A("")
    A("| tokens | " + " | ".join(f"{d['years'][y]['tokens']:,}" for y in years) + " |")
    A("|---|" + "---:|" * len(years))
    A("")
    A("## Captured words")
    A("")
    A("Words Dan entered himself, through the portal, into `lexicon/words/`. A capture is "
      "a word he wanted kept, which is a different fact from a word he uses — and the "
      "reading on each one says which it turned out to be.")
    A("")
    caps = captures()
    if caps:
        A("| word | captured | status | reading |")
        A("|---|---|---|---|")
        for c in caps:
            fm = c["fm"]
            body = c["text"].split("## Reading", 1)
            read = "—"
            if len(body) > 1:
                first = [ln.strip() for ln in body[1].strip().split("\n") if ln.strip()]
                if first:
                    read = re.sub(r"[*_`\[\]]|\(wiki/[^)]*\)", "", first[0])[:110]
            A(f"| `{fm.get('word','?')}` | {fm.get('added','')[:10]} | "
              f"{fm.get('status','pending')} | {read} |")
    else:
        A("_None captured yet._")
    A("")
    A("---")
    A("")
    A("**Up:** [[wiki/interests/index|Interests]] › "
      "[[wiki/interests/language/personal-lexicon|The Personal Lexicon]]")
    return "\n".join(L) + "\n"


def cmd_page(a):
    d = _measured()
    os.makedirs(os.path.dirname(PAGE), exist_ok=True)
    open(PAGE, "w").write(render_page(d))
    print(f"wiki-lexicon page: wrote {os.path.relpath(PAGE, ROOT)}")
    return 0


def cmd_check(a):
    errors, warnings = [], []
    if not os.path.exists(MEASURED):
        errors.append("lexicon/measured.json is missing — run `bin/wiki-lexicon mine`")
    else:
        d = _measured()
        for key in ("meta", "distinctive", "register", "years"):
            if key not in d:
                errors.append(f"lexicon/measured.json has no {key!r} block")
        if os.path.exists(PAGE):
            live = open(PAGE, encoding="utf-8").read()
            if GENERATED not in live:
                errors.append(f"{os.path.relpath(PAGE, ROOT)}: generated marker missing "
                              "— the page was hand-edited; rerun `bin/wiki-lexicon page`")
            elif live != render_page(d):
                errors.append(f"{os.path.relpath(PAGE, ROOT)}: drifted from "
                              "lexicon/measured.json — rerun `bin/wiki-lexicon page`")
        else:
            errors.append(f"{os.path.relpath(PAGE, ROOT)} is missing — "
                          "run `bin/wiki-lexicon page`")

    for c in captures():
        fm = c["fm"]
        if not fm.get("word"):
            errors.append(f"{c['path']}: no `word:` in frontmatter")
        status = fm.get("status", "pending")
        if status not in ("pending", "analyzed", "declined"):
            errors.append(f"{c['path']}: status {status!r} is not "
                          "pending / analyzed / declined")
        if status == "analyzed":
            if not fm.get("analyzed"):
                errors.append(f"{c['path']}: status analyzed with no `analyzed:` date")
            if "_Not yet analysed._" in c["text"]:
                errors.append(f"{c['path']}: marked analyzed but the Reading section "
                              "is still the scaffold")
        elif status == "pending":
            warnings.append(f"{c['path']}: `{fm.get('word','?')}` awaiting a reading "
                            "— bin/wiki-lexicon pending")

    for e in errors:
        print("ERROR " + e)
    for w in warnings:
        print("WARN  " + w)
    print(f"wiki-lexicon: {len(errors)} errors, {len(warnings)} warnings · "
          f"{len(captures())} captured word(s)")
    return 1 if errors else 0


def cmd_new(a):

    now = datetime.datetime.utcnow()
    slug = re.sub(r"[^a-z0-9]+", "-", a.word.lower()).strip("-")
    ident = now.strftime("%Y-%m-%d_%H%M%S_") + slug
    os.makedirs(WORDS, exist_ok=True)
    path = os.path.join(WORDS, ident + ".md")
    if os.path.exists(path):
        sys.exit(f"wiki-lexicon: {path} already exists")
    open(path, "w").write(
        f"---\nid: {ident}\nadded: {now.strftime('%Y-%m-%dT%H:%M:%SZ')}\n"
        f'word: "{a.word}"\nkind: {a.kind}\nstatus: pending\nanalyzed:\ntargets: []\n---\n\n'
        f"## Note\n\n{a.note or ''}\n\n## Reading\n\n_Not yet analysed._\n")
    print(os.path.relpath(path, ROOT))
    return 0


def main():
    p = argparse.ArgumentParser(prog="wiki-lexicon", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("probe", help="per-year rate for a word or phrase")
    s.add_argument("terms", nargs="+")
    s.set_defaults(fn=cmd_probe)

    s = sub.add_parser("distinctive", help="what marks Dan's speech")
    s.add_argument("--kind", choices=["unigram", "bigram", "trigram"], default="unigram")
    s.add_argument("-n", type=int, default=40)
    s.set_defaults(fn=cmd_distinctive)

    s = sub.add_parser("registers", help="texting vs AI-prompt density for a wordlist")
    s.add_argument("words", nargs="*")
    s.add_argument("--page", help="extract the numbered wordlist from a wiki page")
    s.set_defaults(fn=cmd_registers)

    s = sub.add_parser("mine", help="recompute lexicon/measured.json (~60s)")
    s.set_defaults(fn=cmd_mine)

    s = sub.add_parser("pending", help="captured words awaiting a reading")
    s.set_defaults(fn=cmd_pending)

    s = sub.add_parser("show", help="one captured word")
    s.add_argument("id")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("new", help="capture a word from the command line")
    s.add_argument("word")
    s.add_argument("--kind", default="word")
    s.add_argument("--note", default="")
    s.set_defaults(fn=cmd_new)

    s = sub.add_parser("page", help="regenerate the public measured-vocabulary page")
    s.set_defaults(fn=cmd_page)

    s = sub.add_parser("check", help="gate")
    s.set_defaults(fn=cmd_check)

    a = p.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
