margin:1.2rem 0;font-size:.92rem}
footer{margin-top:4rem;padding-top:1.2rem;border-top:1px solid var(--line);
color:var(--dim);font-size:.82rem}
"""


def slug(node_id: str) -> str:
    return node_id.replace(":", "-")


def shell(title: str, body: str, depth: int = 0) -> str:
    up = "../" * depth
    return f"""<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(title)} — Wiki Brain</title>
<link rel="stylesheet" href="{up}style.css">
</head><body><div class="wrap">
<header class="masthead">
<a href="{up}index.html"><div class="name">Wiki Brain</div></a>
<div class="law">RAW DATA → STRUCTURED FACT → INTERPRETATION → SYNTHESIS. NEVER THE REVERSE.</div>
</header>
{body}
<footer>
Generated by <code>bin/wb-build</code>. Every claim traces to its evidence;
nodes marked sensitive are withheld.
<a href="{up}llms.txt">llms.txt</a> · <a href="{up}graph.json">graph.json</a>
</footer>
</div></body></html>
"""


def badge(layer: int) -> str:
    return f'<span class="badge l{layer}">L{layer} {LAYERS[layer][0].split(" ")[0]}</span>'


def link(node_id: str, nodes: dict, depth: int) -> str:
    node = nodes.get(node_id)
    up = "../" * depth
    if not node:
        return f"<code>{html.escape(node_id)}</code>"
    label = html.escape(node.get("title", node_id))
    return (f'<a href="{up}node/{slug(node_id)}.html">{label}</a> '
            f'{badge(node.get("layer", 0))}')


def render_node(node_id: str, node: dict, nodes: dict, incoming: dict) -> str:
    layer = node.get("layer", 0)
    parts = [f'{badge(layer)}<h1>{html.escape(node.get("title", node_id))}</h1>']

    bits = [f'<span><code>{html.escape(node_id)}</code></span>']
    for label, key in (("confidence", "confidence"), ("perspective", "perspective"),
                       ("reliability", "reliability"), ("persistence", "persistence"),
                       ("source type", "source_type"), ("kind", "entity_kind")):
        if node.get(key):
            bits.append(f"<span>{label}: {html.escape(str(node[key]))}</span>")
    when = node.get("when") or {}
    period = when.get("date") or when.get("approx") or (
        f"{when.get('start','?')} → {when.get('end','?')}" if when.get("start") or when.get("end") else "")
    if period:
        bits.append(f"<span>{html.escape(str(period))}</span>")
    parts.append(f'<p class="meta">{"".join(bits)}</p>')

    if node.get("claim"):
        parts.append(f'<div class="claim">{inline(node["claim"])}</div>')
    if node.get("provenance"):
        parts.append(f'<p class="meta">Provenance: {inline(node["provenance"])}</p>')
    if node.get("extraction"):
        parts.append(f'<p class="meta">Extraction: {inline(node["extraction"])}</p>')

    if node.get("_body"):
        parts.append(markdown(node["_body"]))

    if node.get("alternatives"):
        items = "".join(f"<li>{inline(a)}</li>" for a in node["alternatives"])
        parts.append('<div class="trail"><h3>Competing explanations — deliberately unresolved</h3>'
                     f"<ul>{items}</ul></div>")
    if node.get("open_questions"):
        items = "".join(f"<li>{inline(q)}</li>" for q in node["open_questions"])
        parts.append(f'<div class="trail"><h3>Open questions</h3><ul>{items}</ul></div>')

    cites = [c for c in node.get("cites", []) if not nodes.get(c, {}).get("sensitive")]
    withheld = len(node.get("cites", [])) - len(cites)
    if cites or withheld:
        items = "".join(f"<li>{link(c, nodes, 1)}</li>" for c in cites)
        note = (f"<li><em>{withheld} sensitive source"
                f"{'s' if withheld != 1 else ''} withheld from publication</em></li>"
                if withheld else "")
        parts.append('<div class="trail"><h3>Rests on — evidence, strictly below</h3>'
                     f"<ul>{items}{note}</ul></div>")

    supports = [i for i in incoming.get(node_id, []) if not nodes[i].get("sensitive")]
    if supports:
        items = "".join(f"<li>{link(i, nodes, 1)}</li>" for i in sorted(supports))
        parts.append('<div class="trail"><h3>Supports — what rests on this</h3>'
                     f"<ul>{items}</ul></div>")

    edges = [e for e in node.get("edges", [])
             if not nodes.get(e.get("target"), {}).get("sensitive")]
    if edges:
        items = ""
        for edge in edges:
            note = f' — {inline(edge["note"])}' if edge.get("note") else ""
            basis = (f' <em>({html.escape(edge["causal_basis"])})</em>'
                     if edge.get("causal_basis") else "")
            items += (f'<li><code>{html.escape(edge["rel"])}</code>{basis} '
                      f'{link(edge["target"], nodes, 1)}{note}</li>')
        parts.append(f'<div class="trail"><h3>Relations</h3><ul>{items}</ul></div>')

    if node.get("counterexamples"):
        items = "".join(f"<li>{link(c, nodes, 1)}</li>" for c in node["counterexamples"])
        parts.append(f'<div class="trail"><h3>Counterexamples</h3><ul>{items}</ul></div>')

    if layer == 5:
        parts.append('<div class="warn"><strong>This is a synthesis.</strong> It is the most '
                     'disposable node in the system and a leaf — nothing may cite it as '
                     'evidence. Challenge it against the layers below rather than building '
                     'on it.</div>')
    return "\n".join(parts)


def build(kb: pathlib.Path, out: pathlib.Path, base: str) -> int:
    nodes, errors = load_nodes(kb)
    if errors:
        print("knowledge base does not load cleanly:", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        return 1

    public = {i: n for i, n in nodes.items() if not n.get("sensitive")}
    withheld = len(nodes) - len(public)

    incoming: dict[str, list[str]] = {}
    for node_id, node in nodes.items():
        for target in node.get("cites", []):
            incoming.setdefault(target, []).append(node_id)

    if out.exists():
        shutil.rmtree(out)
    (out / "node").mkdir(parents=True)
    (out / "agent").mkdir(parents=True)
    (out / "style.css").write_text(CSS.strip() + "\n")

    for node_id, node in public.items():
        (out / "node" / f"{slug(node_id)}.html").write_text(
            shell(node.get("title", node_id), render_node(node_id, node, nodes, incoming), depth=1))

    by_layer: dict[int, list[str]] = {}
    for node_id, node in public.items():
        by_layer.setdefault(node.get("layer", 0), []).append(node_id)

    for layer, ids in by_layer.items():
        name, blurb = LAYERS[layer]
        items = ""
        for node_id in sorted(ids, key=lambda i: public[i].get("title", "")):
            node = public[node_id]
            sub = node.get("claim") or (node.get("_body", "").split("\n\n")[0][:170])
            items += (f'<li><a href="node/{slug(node_id)}.html">'
                      f'{html.escape(node.get("title", node_id))}</a>'
                      f'<div class="t">{inline(sub)}</div></li>')
        body = (f"{badge(layer)}<h1>{html.escape(name)}</h1><p class=\"meta\">{html.escape(blurb)}</p>"
                f'<ul class="nodes">{items}</ul>')
        (out / f"layer-{layer}.html").write_text(shell(name, body))

    rows = ""
    for layer in sorted(LAYERS):
        name, blurb = LAYERS[layer]
        count = len(by_layer.get(layer, []))
        rows += (f'<tr><td>{badge(layer)}</td>'
                 f'<td><a href="layer-{layer}.html">{html.escape(name)}</a><div class="t">'
                 f'{html.escape(blurb)}</div></td><td>{count}</td></tr>')
    note = (f'<div class="warn">{withheld} node(s) marked sensitive are withheld from this '
            f'site, along with citations pointing at them. This repository is public and the '
            f'material they hold is not only the subject\'s.</div>' if withheld else "")
    index = f"""<h1>Wiki Brain</h1>
<p>A source-grounded, longitudinal knowledge graph. It archives raw evidence about a person
and their world, turns it into atomic facts, events, entities, relationships, patterns and
syntheses, and keeps those layers from collapsing into one another.</p>
<p class="meta">{len(public)} published nodes{f", {withheld} withheld" if withheld else ""}</p>
<h2>Layers</h2>
<p>A node may cite only nodes at a <strong>strictly lower</strong> layer. That single rule is
what stops a conclusion from becoming a premise, and it is checked on every build by
<code>bin/wb-validate</code> rather than left to discipline.</p>
<table>{rows}</table>
{note}
<h2>For agents</h2>
<ul class="nodes">
<li><a href="llms.txt">llms.txt</a><div class="t">discovery document</div></li>
<li><a href="graph.json">graph.json</a><div class="t">full graph — nodes, citations, typed edges</div></li>
<li><a href="agent/manifest.json">agent/manifest.json</a><div class="t">endpoint map</div></li>
</ul>"""
    (out / "index.html").write_text(shell("Wiki Brain", index))

    graph = {
        "generated_from": "kb/",
        "base_url": base,
        "law": "RAW DATA -> STRUCTURED FACT -> INTERPRETATION -> SYNTHESIS. NEVER THE REVERSE.",
        "invariant": "A node may cite only nodes at a strictly lower layer.",
        "layers": {str(k): {"name": v[0], "description": v[1]} for k, v in LAYERS.items()},
        "withheld_sensitive": withheld,
        "nodes": [
            {k: v for k, v in sorted(node.items())
             if not k.startswith("_") or k == "_body"}
            | {"url": f"{base}/node/{slug(node_id)}.html",
               "cited_by": sorted(i for i in incoming.get(node_id, [])
                                  if i in public)}
            for node_id, node in sorted(public.items())
        ],
    }
    for entry in graph["nodes"]:
        entry["body"] = entry.pop("_body", "")
        entry["cites"] = [c for c in entry.get("cites", []) if c in public]
    (out / "graph.json").write_text(json.dumps(graph, indent=2) + "\n")

    (out / "agent" / "manifest.json").write_text(json.dumps({
        "name": "wiki-brain",
        "description": "Source-grounded longitudinal knowledge graph with enforced epistemic layering.",
        "base_url": base,
        "endpoints": {
            "graph": f"{base}/graph.json",
            "discovery": f"{base}/llms.txt",
            "node": f"{base}/node/{{id-with-colon-as-hyphen}}.html",
        },
        "reading_guidance": [
            "Check a node's layer before treating it as fact. L0-L2 is evidence; L3-L5 is reading.",
            "An L3 interpretation carries `perspective`: self, external, llm or other. These are not interchangeable.",
            "L5 syntheses are leaves and the most disposable nodes here. Do not build on them.",
            "Contradictions are preserved unresolved on purpose. 'The record is ambiguous' is a valid answer.",
            "Sensitive nodes are withheld, so absence from this feed is not evidence of absence.",
        ],
        "counts": {str(k): len(by_layer.get(k, [])) for k in sorted(LAYERS)},
    }, indent=2) + "\n")

    lines = [
        "# Wiki Brain",
        "",
        "> A source-grounded, longitudinal knowledge graph and cognitive modeling system.",
        "> Evidence, interpretation and inference are kept in separate layers and never collapsed.",
        "",
        "RAW DATA -> STRUCTURED FACT -> INTERPRETATION -> SYNTHESIS. NEVER THE REVERSE.",
        "",
        "A node may cite only nodes at a strictly lower layer. Every conclusion therefore",
        "traces to evidence in a walk that terminates.",
        "",
        "## How to read this",
        "",
        "- L0 source, L1 datum, L2 entity/event/relationship: evidence.",
        "- L3 interpretation, L4 pattern, L5 synthesis: reading. Not facts.",
        "- L5 is a leaf and the most disposable layer. Challenge it; do not build on it.",
        "- Contradictions are preserved unresolved. Ambiguity is a valid answer.",
        f"- {withheld} sensitive node(s) are withheld. Absence here is not evidence of absence.",
        "",
        "## Feeds",
        "",
        f"- [Full graph]({base}/graph.json)",
        f"- [Agent manifest]({base}/agent/manifest.json)",
        "",
    ]
    for layer in sorted(by_layer):
        lines.append(f"## L{layer} — {LAYERS[layer][0]}")
        lines.append("")
        for node_id in sorted(by_layer[layer], key=lambda i: public[i].get("title", "")):
            node = public[node_id]
            lines.append(f"- [{node.get('title', node_id)}]({base}/node/{slug(node_id)}.html): "
                         f"{node.get('claim') or LAYERS[layer][0]}")
        lines.append("")
    (out / "llms.txt").write_text("\n".join(lines))

    print(f"built {len(public)} pages into {out}"
          + (f" ({withheld} sensitive node(s) withheld)" if withheld else ""))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", type=pathlib.Path, default=OUT)
    ap.add_argument("--kb", type=pathlib.Path, default=KB)
    ap.add_argument("--base", default=BASE_URL)
    args = ap.parse_args()
    return build(args.kb, args.out, args.base.rstrip("/"))


if __name__ == "__main__":
    raise SystemExit(main())
