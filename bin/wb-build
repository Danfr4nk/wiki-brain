letter-spacing:.06em;text-transform:uppercase;padding:.32em .6em;border-radius:3px;
border:1px solid currentColor;vertical-align:.12em}
.l0{color:var(--l0)}.l1{color:var(--l1)}.l2{color:var(--l2)}
