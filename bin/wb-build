#!/usr/bin/env python3
"""Compile the knowledge base into a static site and machine-readable feeds.

Produces, in site/:

  index.html            overview, layer navigation, the constitutional law
  layer-N.html          every node at one layer
  node/<id>.html        one node, with its evidence trail in both directions
  graph.json            the full graph for agents
  llms.txt              discovery document
  agent/manifest.json   endpoint map

The distinctive thing rendered here is the **evidence trail**. Every node shows
what it cites (downward, toward evidence) and what cites it (upward, toward
conclusions). Because the layer invariant makes citations a DAG, "trace this
conclusion to its sources" is a walk that always terminates, and the site
renders that walk rather than leaving it to be reconstructed by hand.

Nodes marked `sensitive = true` are excluded from every artifact, and so are
citations pointing at them. This repository is public.

Usage:
  bin/wb-build              build into site/
  bin/wb-build --out DIR    build elsewhere
  bin/wb-build --base URL   set the canonical base URL

Standard library only, matching the rest of the project.
"""

from __future__ import annotations

import argparse
import html
import json
import pathlib
import re
import shutil
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from importlib.machinery import SourceFileLoader

ROOT = pathlib.Path(__file__).resolve().parent.parent
KB = ROOT / "kb"
OUT = ROOT / "site"
BASE_URL = "https://danfr4nk.github.io/wiki-brain"

_validate = SourceFileLoader("wb_validate", str(ROOT / "bin" / "wb-validate")).load_module()
load_nodes = _validate.load_nodes
PREFIX = _validate.PREFIX

LAYERS = {
    0: ("Sources", "Raw material as acquired. Append-only, never interpreted."),
    1: ("Data", "One claim about one thing at one time, with known provenance."),
    2: ("Entities & events", "Structured objects assembled from data. Who, what, when."),
    3: ("Interpretations", "What it might mean. Someone's reading, never a fact."),
    4: ("Patterns", "Recurrence detected across interpretations and events."),
    5: ("Syntheses", "Cross-domain models. The compressed picture, and the most disposable."),
}


# --------------------------------------------------------------------------
# A small Markdown subset renderer — headings, emphasis, code, lists, quotes,
# links, tables. Written out rather than depended on, like everything else here.
# --------------------------------------------------------------------------

def inline(text: str) -> str:
    out = html.escape(text, quote=False)
    out = re.sub(r"`([^`]+)`", lambda m: f"<code>{m.group(1)}</code>", out)
    out = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"(?<![*\w])\*([^*\n]+)\*(?!\w)", r"<em>\1</em>", out)
    out = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
                 lambda m: f'<a href="{html.escape(m.group(2), quote=True)}">{m.group(1)}</a>', out)
    return out


def markdown(text: str) -> str:
    lines = text.split("\n")
    html_parts: list[str] = []
    para: list[str] = []
    list_stack: str | None = None
    in_code = False
    code: list[str] = []

    def flush_para() -> None:
        nonlocal para
        if para:
            html_parts.append(f"<p>{inline(' '.join(para))}</p>")
            para = []

    def flush_list() -> None:
        nonlocal list_stack
        if list_stack:
            html_parts.append(f"</{list_stack}>")
            list_stack = None

    for raw in lines:
        if raw.startswith("```"):
            if in_code:
                body = html.escape("\n".join(code), quote=False)
                html_parts.append(f"<pre><code>{body}</code></pre>")
                code, in_code = [], False
            else:
                flush_para(); flush_list()
                in_code = True
            continue
        if in_code:
            code.append(raw)
            continue

        line = raw.rstrip()
        if not line.strip():
            flush_para(); flush_list()
            continue

        heading = re.match(r"^(#{1,6})\s+(.*)$", line)
        if heading:
            flush_para(); flush_list()
            level = len(heading.group(1)) + 1  # page <h1> is the node title
            html_parts.append(f"<h{level}>{inline(heading.group(2))}</h{level}>")
            continue

        if line.startswith("> "):
            flush_para(); flush_list()
            html_parts.append(f"<blockquote>{inline(line[2:])}</blockquote>")
            continue

        bullet = re.match(r"^\s*[-*]\s+(.*)$", line)
        number = re.match(r"^\s*\d+\.\s+(.*)$", line)
        if bullet or number:
            want = "ul" if bullet else "ol"
            flush_para()
            if list_stack != want:
                flush_list()
                html_parts.append(f"<{want}>")
                list_stack = want
            html_parts.append(f"<li>{inline((bullet or number).group(1))}</li>")
            continue

        if line.startswith("|"):
            flush_para(); flush_list()
            cells = [c.strip() for c in line.strip("|").split("|")]
            if all(re.fullmatch(r":?-{2,}:?", c) for c in cells):
                continue
            tag = "th" if not html_parts or not html_parts[-1].startswith("<tr") else "td"
            row = "".join(f"<{tag}>{inline(c)}</{tag}>" for c in cells)
            html_parts.append(f"<tr>{row}</tr>")
            continue

        para.append(line.strip())

    flush_para(); flush_list()
    if in_code and code:
        html_parts.append(f"<pre><code>{html.escape(chr(10).join(code))}</code></pre>")

    joined = "\n".join(html_parts)
    return re.sub(r"((?:<tr>.*?</tr>\s*)+)", r"<table>\1</table>", joined, flags=re.S)


# --------------------------------------------------------------------------
# Page shell
# --------------------------------------------------------------------------

CSS = """
:root{--bg:#fbfaf8;--fg:#1c1b19;--dim:#6b6862;--line:#e3e0da;--card:#fff;
--l0:#7a6a55;--l1:#4a6d7c;--l2:#3f7d5c;--l3:#8a6a3d;--l4:#7a5a80;--l5:#8c4a4a;}
@media (prefers-color-scheme:dark){:root{--bg:#141412;--fg:#e8e6e1;--dim:#9a958c;
--line:#2c2b27;--card:#1c1b19;--l0:#b6a184;--l1:#7fa8bb;--l2:#6fb992;--l3:#c9a35f;
--l4:#b28fb8;--l5:#cf8080;}}
*{box-sizing:border-box}
