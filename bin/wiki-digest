#!/usr/bin/env python3
"""wiki-digest — generate human-facing reading aids from the wiki.

Writes three files at the repo root, all generated-but-COMMITTED (like llm/):

  RECENT.md    what changed lately, newest first, with the reason
  OPEN.md      every unresolved contradiction, gap and prediction in one place
  DIGEST.md    the front door: counts, altitude, and the top of both lists

...and mirrors each one's content into wiki/meta/ (recent-activity.md,
open-questions.md, digest.md) so the same content has a wiki/ address the
portal's sync actually reads (CLAUDE.md, "the portal" — sync only reads
wiki/** and sage/questions/**, so a root .md is invisible on the live site).

Nothing here is a source of truth. Everything is derived from wiki/ frontmatter
and from the dated blocks pages already carry, so it is safe to regenerate at
any time. Run it after a content pass, alongside bin/llm-publish.

Pure stdlib, no arguments.
"""
import os
import re
from collections import defaultdict
from datetime import date, datetime, timedelta

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WIKI = os.path.join(ROOT, "wiki")

# On-site mirrors of the three root reading aids. The portal's sync only reads
# wiki/** and sage/questions/**, so a root-level .md is invisible on the live
# site (CLAUDE.md, "the portal" bullet) — these give the same generated content
# a wiki/ address. domain: meta because this is the wiki describing itself,
# not describing Dan (STYLE_GUIDE.md, "Themed journeys" section).
META_DIR = os.path.join(WIKI, "meta")
MIRROR_CREATED = "2026-08-26"  # first-emitted date; never recomputed on rerun


MIRROR_NAV = (
    "[[wiki/meta/digest|Digest]] · [[wiki/meta/recent-activity|Recent]] · "
    "[[wiki/meta/open-questions|Open]]"
)


def write_wiki_mirror(wiki_path, title, root_name, body_lines):
    """Wrap generated body lines as a wiki/meta/ page and write it.

    `body_lines` is the substantive content already built for the matching
    root file (table + list sections) — the root file's own boilerplate
    header is not reused, since it links to the other two root .md files,
    which don't exist as wiki pages; this gets its own header linking the
    wiki/meta/ siblings instead.
    """
    fm = (
        "---\n"
        "domain: meta\n"
        "page_type: report\n"
        f'title: "{title}"\n'
        "status: active\n"
        "knowledge: derived\n"
        f"date_created: {MIRROR_CREATED}\n"
        f"date_modified: {date.today().isoformat()}\n"
        "sources: []\n"
        "---\n"
    )
    lead = [
        f"# {title}",
        "",
        f"_Generated by `bin/wiki-digest`, mirroring `{root_name}` for on-site",
        "reading — the repo's copy is authoritative if the two ever diverge",
        "between regenerations. Do not hand-edit here — rerun the tool._",
        "",
        MIRROR_NAV,
        "",
    ]
    os.makedirs(META_DIR, exist_ok=True)
    text = fm + "\n" + "\n".join(lead + body_lines) + "\n"
    open(os.path.join(ROOT, wiki_path), "w", encoding="utf-8").write(text)

# Dated blocks a page uses to record what happened to it.
BLOCK_RE = re.compile(
    r"\*\*(REVISED|RE-CHECKED|CORRECTED|GAP CLOSED|CONTRADICTION|DEADLINE ELAPSED)"
    r"\s*\[?(\d{4}-\d{2}-\d{2})?\]?[^*]*\*\*(?::)?\s*(.{0,240})",
    re.S,
)
# A contradiction block, with its own head captured so the filter below can
# read it. The head is `CONTRADICTION`, optionally followed by the word that
# says it is finished — `CONTRADICTION CLOSED [2026-08-16]`,
# `CONTRADICTION RESOLVED [2026-08-02]` — and then the argument.
CONTRA_RE = re.compile(r"^>\s*\*\*CONTRADICTION([^*]*)\*\*:?\s*(.{0,400})", re.M | re.S)

# The three marks a page uses to say an item is settled. The gap extractor
# below has always applied them; the contradiction extractor never did, so
# every contradiction the wiki actually closed stayed on the live list
# forever. Three of the 44 were closed — one on 2026-08-16 and two on
# 2026-08-02 — which made this file's headline count, and the OPEN.md table
# it feeds, read three high for three weeks.
SETTLED_RE = re.compile(r"\b(CLOSED|RESOLVED|SETTLED|WITHDRAWN)\b", re.I)

# Where a page writes down what it does not know. `## Gaps` is 107 of the 112 in
# the corpus; the rest are the same section under another name, and were invisible
# here until they were listed. Matched by the whole heading rather than by "the
# word gap appears", which would swallow prose headings like "## The landscape gap
# he identifies". Kept in step with GAP_HEAD in bin/wiki-gaps. Pages carry more
# than one — jerel-coles has both an `## Open questions` and a `## Gaps` — so this
# is iterated, never searched once.
# Item shapes inside a gaps section. Kept identical to `bin/wiki-gaps` and to
# the portal's port of it — see the note in gap_items().
BULLET_RE = re.compile(r"^([-*]|\d+\.)\s+\S")
TABLE_ROW_RE = re.compile(r"^[ \t]*\|")
TABLE_RULE_RE = re.compile(r"^[ \t]*\|[\s:|-]+\|[ \t]*$")
# How the corrections tables mark a row already dealt with.
DONE_CELL_RE = re.compile(r"\b(applied|n/a)\b", re.I)

GAPS_SECTION = re.compile(
    r"^##+[ \t]+(?:\d+[.)][ \t]*)?(?:new[ \t]+)?"
    r"(?:gaps?\b|notes[ \t]+(?:and|&)[ \t]+gaps\b|corpus[ \t]+gaps\b|open[ \t]+questions\b"
    r"|open[ \t]+leads\b|leads\b|corrections[ \t]+queue\b|what'?s[ \t]+missing\b|unresolved\b)"
    r".*?$(.*?)(?=^##\s|\Z)",
    re.M | re.S | re.I,
)


def pages():
    for dirpath, _dirs, files in os.walk(WIKI):
        for f in sorted(files):
            if f.endswith(".md"):
                yield os.path.join(dirpath, f)


def split_fm(text):
    if not text.startswith("---"):
        return "", text
    end = text.find("\n---", 3)
    if end == -1:
        return "", text
    return text[3:end], text[end + 4 :]


def field(fm, name):
    m = re.search(r"^%s:\s*(.+)$" % name, fm, re.M)
    return m.group(1).strip().strip("\"'") if m else ""


def synthesizes_count(fm):
    """How many wiki pages this page's `synthesizes:` block names.

    Returns 0 for a page with no such field and for the inline empty form
    `synthesizes: []`, which declares the field without naming a premise.
    """
    m = re.search(r"synthesizes:\s*\n((?:[ \t]+-\s+.*\n)+)", fm)
    if not m:
        return 0
    return len(re.findall(r"^\s+-\s+wiki/", m.group(1), re.M))


def rel(path):
    return os.path.relpath(path, ROOT).replace(".md", "")


def tidy(s):
    # A regex capture upstream (BLOCK_RE's bounded .{0,N} groups) can cut a
    # source string off mid-wikilink, leaving a dangling "[[path/with/no/close"
    # that the wikilink substitutions below can't recognize (they require the
    # closing "]]") and so pass through untouched — a broken link on a
    # generated page. Trim any "[[" with no matching "]]" after it before the
    # real substitutions run, so a mid-link cut degrades to "lost the last
    # fragment" rather than "emits invalid markdown".
    last_open = s.rfind("[[")
    if last_open != -1 and s.find("]]", last_open) == -1:
        s = s[:last_open]
    # [[path|Label]] -> Label ; [[a/b/c]] -> c
    s = re.sub(r"\[\[[^\]|]+\|([^\]]+)\]\]", r"\1", s)
    s = re.sub(r"\[\[([^\]]+)\]\]", lambda m: m.group(1).rstrip("/").split("/")[-1], s)
    s = re.sub(r"^[ \t]*>[ \t]?", "", s, flags=re.M)   # blockquote markers
    s = re.sub(r"\s+", " ", s).strip()
    s = re.sub(r"^[-—:\s]+", "", s)
    return s


def load():
    out = []
    for p in pages():
        try:
            text = open(p, encoding="utf-8").read()
        except OSError:
            continue
        fm, body = split_fm(text)
        if not fm:
            continue
        out.append(
            {
                "path": rel(p),
                "file": p,
                "title": field(fm, "title") or os.path.basename(p)[:-3].replace("-", " "),
                "domain": field(fm, "domain"),
                "status": field(fm, "status"),
                "knowledge": field(fm, "knowledge"),
                "modified": field(fm, "date_modified"),
                "body": body,
                "fm": fm,
            }
        )
    return out


def log_reasons():
    """Map date -> the log.md lines for that date, so RECENT can say why."""
    reasons = defaultdict(list)
    path = os.path.join(ROOT, "log.md")
    if not os.path.exists(path):
        return reasons
    for line in open(path, encoding="utf-8"):
        m = re.match(r"^##\s*\[(\d{4}-\d{2}-\d{2})\]\s*(.+)$", line.strip())
        if m:
            reasons[m.group(1)].append(m.group(2).strip())
    return reasons


def newest_block(body):
    """The most recent dated block on a page, as (kind, date, gist)."""
    best = None
    for m in BLOCK_RE.finditer(body):
        kind, when, gist = m.group(1), m.group(2) or "", m.group(3)
        if best is None or when > best[1]:
            best = (kind, when, tidy(gist))
    return best


def write_recent(entries, reasons):
    by_date = defaultdict(list)
    for e in entries:
        if e["modified"]:
            by_date[e["modified"]].append(e)

    intro = [
        "What changed, newest first, by the `date_modified` each page carries. The",
        "**why** column is the page's own most recent dated block (`REVISED`,",
        "`RE-CHECKED`, `CORRECTED`, `GAP CLOSED`, `CONTRADICTION`) where it has one —",
        "so a page that recorded why it moved says so here, and one that did not is",
        "simply listed.",
        "",
    ]

    # Two variants: the root file quotes log.md's own session-log lines
    # verbatim (raw operator/session narration, safe on a generated meta doc
    # outside wiki/); the wiki mirror omits them — STYLE_GUIDE prose rule 6
    # forbids "session notes... this pass did X" on an actual wiki/ page, and
    # log.md lines can reference a retracted figure in the course of
    # describing its own retraction (safe in log.md, not safe re-asserted on
    # a gated wiki/ page without the correction's own blockquote context).
    body, body_wiki = [], []
    for when in sorted(by_date, reverse=True)[:20]:
        group = sorted(by_date[when], key=lambda e: (e["domain"], e["path"]))
        heading = "## %s — %d page%s" % (when, len(group), "" if len(group) == 1 else "s")
        body.append(heading)
        body.append("")
        body_wiki.append(heading)
        body_wiki.append("")
        for line in reasons.get(when, []):
            body.append("- **Session log:** %s" % line)
        if reasons.get(when):
            body.append("")
        table = ["| Page | Domain | What moved |", "|---|---|---|"]
        for e in group:
            blk = newest_block(e["body"])
            why = ""
            if blk and blk[1] == when:
                why = "**%s** — %s" % (blk[0], blk[2][:200])
            elif blk:
                why = (
                    "_(carries a %s from %s)_" % (blk[0], blk[1])
                    if blk[1]
                    else "_(carries a %s)_" % blk[0]
                )
            table.append(
                "| [[%s]] | %s | %s |" % (e["path"], e["domain"] or "—", why or "—")
            )
        body += table + [""]
        body_wiki += table + [""]

    out = [
        "# Recent Activity",
        "",
        "_Generated by `bin/wiki-digest`. Do not hand-edit — rerun the tool._",
        "",
    ] + intro + body
    open(os.path.join(ROOT, "RECENT.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
    write_wiki_mirror(
        "wiki/meta/recent-activity.md", "Recent Activity", "RECENT.md", intro + body_wiki
    )
    return sum(len(v) for v in by_date.values())


def gap_items(section):
    """Split a Gaps section into individual gaps.

    Two shapes are in the corpus and both are legal: bulleted lists — with
    wrapped continuation lines and nested sub-bullets — and bare paragraphs.
    This used to match `^-\\s+` only, which meant every prose gaps section in
    the wiki (83 gaps across 78 pages when this was fixed) was silently absent
    from OPEN.md: the pages had written down what they did not know and the
    file collecting exactly that could not see them.

    So: split on blank lines, then split any block that opens with a top-level
    bullet at each subsequent top-level bullet. Nested bullets are indented, so
    they stay with the item they belong to.

    Two rules below arrived in `bin/wiki-gaps` on 2026-08-17 with the widened
    GAP_HEAD and were never brought over here, which is why this file counted
    481 gaps against the 485 the tool and the portal both counted:

      PREAMBLE  a section that itemises may open with a sentence explaining the
                list, and that sentence is not a gap. Five pages had theirs
                counted as one — `people/zaco`'s "Each answerable by the
                operator in a paragraph" among them.
      TABLES    a corrections queue is a table and its *rows* are the items.
                Read as one blob, `timeline/annie-read-notes` reported one gap
                where it has nine, and rows already marked applied or n/a were
                counted as open.

    Three parsers read these sections — this one, `bin/wiki-gaps`, and the
    portal's port in `sync-wiki.mjs` — and they have to agree, because the tool
    finds a gap on the page by matching the text this file publishes. Keep them
    in step.
    """
    lines = section.split("\n")
    blocks, cur = [], []
    for i, line in enumerate(lines):
        if line.strip():
            cur.append(i)
        elif cur:
            blocks.append(cur)
            cur = []
    if cur:
        blocks.append(cur)

    def itemised(block):
        return any(BULLET_RE.match(lines[i]) or TABLE_ROW_RE.match(lines[i]) for i in block)

    first_itemised = next((n for n, b in enumerate(blocks) if itemised(b)), None)

    out = []
    for n, indices in enumerate(blocks):
        if first_itemised is not None and n < first_itemised:
            continue  # prose explaining the list, not an item in it

        if TABLE_ROW_RE.match(lines[indices[0]]):
            for i in indices:
                if TABLE_RULE_RE.match(lines[i]):
                    continue
                if i + 1 in indices and TABLE_RULE_RE.match(lines[i + 1]):
                    continue  # the header row is the one above the rule
                cells = [c.strip() for c in lines[i].strip().strip("|").split("|")]
                if not any(cells):
                    continue
                if DONE_CELL_RE.search(cells[-1]):
                    continue
                out.append(" · ".join(c for c in cells if c))
            continue

        block = "\n".join(lines[i] for i in indices).rstrip()
        if not block.strip():
            continue
        first = block.lstrip()
        if first.startswith("#") or first.startswith(">"):
            continue  # sub-heading or blockquote — commentary, not a gap
        if re.match(r"^[-*]|^\d+\.", first):
            out += [b for b in re.split(r"^(?=[-*]\s|\d+\.\s)", block, flags=re.M) if b.strip()]
        else:
            out.append(block)
    return out


def write_open(entries):
    contradictions, gaps, predictions, answered = [], [], [], []

    for e in entries:
        body = e["body"]

        for m in CONTRA_RE.finditer(body):
            if SETTLED_RE.search(m.group(1)):
                continue  # the page says it closed this one
            contradictions.append((e, tidy(m.group(2))[:320]))

        # Gaps the operator has answered but nobody has acted on yet — staged by
        # bin/wiki-gaps and flagged in frontmatter. These are the cheapest items
        # in this file by a wide margin: the evidence is already in the repo and
        # the work is integration, not research.
        if field(e["fm"], "pending_ingest"):
            heads = re.findall(r"^### ANSWERED \[[\d-]+\] — (.+)$", body, re.M)
            answered.append((e, field(e["fm"], "pending_ingest"), heads))

        for gs in GAPS_SECTION.finditer(body):
            for line in gap_items(gs.group(1)):
                flat = tidy(line)
                if not flat or flat.startswith("~~"):
                    continue  # struck through = resolved
                if re.search(r"\b(CLOSED|RESOLVED|SETTLED)\b", flat):
                    continue
                gaps.append((e, flat[:260]))

        ps = re.search(r"^##+\s*Predictions?\b.*?$(.*?)(?=^##\s|\Z)", body, re.M | re.S)
        if ps:
            for line in re.findall(r"^\d+\.\s+(.+?)(?=\n\d+\.\s|\n\n|\Z)", ps.group(1), re.M | re.S):
                flat = tidy(line)
                if flat:
                    predictions.append((e, flat[:260]))

    intro = [
        "Everything the wiki currently admits it does not know, collected from the",
        "pages themselves. A gap struck through or marked CLOSED/RESOLVED/SETTLED is",
        "filtered out, so this list shrinks only when something is actually settled.",
        "",
        "| | count |",
        "|---|---|",
        "| Live contradictions | %d |" % len(contradictions),
        "| Open gaps | %d |" % len(gaps),
        "| Answered, awaiting ingest | %d |" % sum(len(h) for _, _, h in answered),
        "| Standing predictions | %d |" % len(predictions),
        "",
    ]

    body = [
        "## Answered, awaiting ingest",
        "",
        "Gaps the operator has already answered in a `## Operator answers — pending",
        "ingest` block, which nothing has acted on yet. The evidence is in the repo;",
        "what is missing is the pass that corrects the page and every page that",
        "inherited the gap, then runs `bin/wiki-gaps clear <page>`. Cheapest work",
        "here — no new source required, and the answer is already written down.",
        "",
    ]
    for e, when, heads in sorted(answered, key=lambda x: (x[1], x[0]["path"])):
        body.append("- **[[%s]]** — staged %s, %d answer%s"
                   % (e["path"], when, len(heads), "" if len(heads) == 1 else "s"))
        for h in heads:
            body.append("  - %s" % tidy(h)[:200])
    if not answered:
        body.append("_Nothing staged._")

    body += [
        "",
        "## Live contradictions",
        "",
        "Pages making incompatible claims, held rather than resolved. These are the",
        "highest-value items here: each one is a place the corpus knows it is wrong",
        "somewhere and has not yet found out where.",
        "",
    ]
    for e, gist in sorted(contradictions, key=lambda x: x[0]["path"]):
        body.append("- **[[%s]]** — %s" % (e["path"], gist))
    if not contradictions:
        body.append("_None recorded._")

    body += [
        "",
        "## Standing predictions",
        "",
        "Falsifiable claims awaiting a verdict. Scoring one of these is the cheapest",
        "new knowledge available, because no new source is required.",
        "",
    ]
    for e, gist in sorted(predictions, key=lambda x: x[0]["path"]):
        body.append("- **[[%s]]** — %s" % (e["path"], gist))
    if not predictions:
        body.append("_None recorded._")

    body += ["", "## Open gaps, by domain", ""]
    by_dom = defaultdict(list)
    for e, gist in gaps:
        by_dom[e["domain"] or "—"].append((e, gist))
    for dom in sorted(by_dom):
        body.append("### %s (%d)" % (dom, len(by_dom[dom])))
        body.append("")
        for e, gist in sorted(by_dom[dom], key=lambda x: x[0]["path"]):
            body.append("- **[[%s]]** — %s" % (e["path"], gist))
        body.append("")

    out = [
        "# Open Questions",
        "",
        "_Generated by `bin/wiki-digest`. Do not hand-edit — rerun the tool._",
        "",
    ] + intro + body
    open(os.path.join(ROOT, "OPEN.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
    write_wiki_mirror(
        "wiki/meta/open-questions.md", "Open Questions", "OPEN.md", intro + body
    )
    return len(contradictions), len(gaps), len(predictions)


def write_digest(entries, touched, counts, reasons):
    contra, gaps, preds = counts
    doms = defaultdict(int)
    stat = defaultdict(int)
    for e in entries:
        doms[e["domain"] or "—"] += 1
        stat[e["status"] or "—"] += 1

    # An empty `synthesizes: []` declares the field without reasoning from
    # anything, so it belongs in neither the count nor the listing below.
    synth = [e for e in entries if synthesizes_count(e["fm"])]
    today = date.today().isoformat()
    recent_cut = (datetime.now() - timedelta(days=14)).date().isoformat()
    fresh = [e for e in entries if e["modified"] >= recent_cut]

    body = [
        "## Size",
        "",
        "| | |",
        "|---|---|",
        "| Pages | %d |" % len(entries),
        "| Pages touched in the last 14 days | %d |" % len(fresh),
        "| Pages reasoning from other pages (`synthesizes:`) | %d |" % len(synth),
        "| Live contradictions | %d |" % contra,
        "| Open gaps | %d |" % gaps,
        "| Standing predictions | %d |" % preds,
        "",
        "## By domain",
        "",
        "| Domain | Pages |",
        "|---|---|",
    ]
    for d in sorted(doms, key=lambda k: -doms[k]):
        body.append("| %s | %d |" % (d, doms[d]))

    body += ["", "## By status", "", "| Status | Pages |", "|---|---|"]
    for s in sorted(stat, key=lambda k: -stat[k]):
        body.append("| %s | %d |" % (s, stat[s]))

    body += [
        "",
        "## The last few days",
        "",
    ]
    for when in sorted({e["modified"] for e in entries if e["modified"]}, reverse=True)[:5]:
        n = len([e for e in entries if e["modified"] == when])
        body.append("**%s** — %d page%s" % (when, n, "" if n == 1 else "s"))
        for line in reasons.get(when, []):
            body.append("  - %s" % line)
        body.append("")

    body += [
        "## Pages that reason from other pages",
        "",
        "The altitude of the wiki — everything here was built on top of something",
        "else in it, and `bin/wiki-climb check` will flag any of them whose premises",
        "have moved since.",
        "",
    ]
    for e in sorted(synth, key=lambda e: e["path"]):
        n = synthesizes_count(e["fm"])
        body.append("- [[%s]] — %d premise%s" % (e["path"], n, "" if n == 1 else "s"))

    out = [
        "# Wiki Digest",
        "",
        "_Generated by `bin/wiki-digest` on %s. Do not hand-edit._" % today,
        "",
        "The front door for a human. [index.md](index.md) is the navigational map;",
        "this is the state of the thing.",
        "",
        "- **[RECENT.md](RECENT.md)** — what changed lately and why",
        "- **[OPEN.md](OPEN.md)** — every unresolved contradiction, gap and prediction,\n"
        "  and every operator answer still waiting to be ingested",
        "",
    ] + body
    open(os.path.join(ROOT, "DIGEST.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
    write_wiki_mirror("wiki/meta/digest.md", "Wiki Digest", "DIGEST.md", body)


def main():
    entries = load()
    reasons = log_reasons()
    touched = write_recent(entries, reasons)
    counts = write_open(entries)
    write_digest(entries, touched, counts, reasons)
    print(
        "wiki-digest: %d pages -> DIGEST.md, RECENT.md, OPEN.md + wiki/meta/ mirrors "
        "(%d contradictions, %d gaps, %d predictions)"
        % (len(entries), counts[0], counts[1], counts[2])
    )


if __name__ == "__main__":
    main()
