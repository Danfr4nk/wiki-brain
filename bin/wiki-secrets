#!/usr/bin/env python3
"""wiki-secrets — scan what is about to be committed for credential shapes.

    bin/wiki-secrets            the working diff plus untracked files
    bin/wiki-secrets check      the same, as a gate (runs inside bin/wiki-check)
    bin/wiki-secrets --staged   only what `git add` has staged

WHAT THIS IS

`bin/wiki-skills` already refuses a credential shape at the point of entry, and
that is the right place for the one surface it owns. But it owns one surface.
Everything else that reaches this repository — a capture pasted into `inbox/`,
an export filed to `raw/`, a config committed alongside a tool, a token pasted
into a page while debugging — has never been scanned by anything.

**This repository is public and its history cannot be un-published.** That is
the operator's decision of 2026-08-30, taken deliberately and documented in
`CLAUDE.md`; it is also the reason a leaked key here is permanent rather than
embarrassing. A secret scan is cheap and the failure it prevents is not
recoverable.

WHY IT SCANS THE DIFF AND NOT THE TREE

Scanning the whole repository would be worse than useless. `raw/` holds message
dumps, browser-history exports and 130,000 received messages, and a corpus that
size will contain strings shaped like keys that are not keys. A gate that fires
on immutable archive material would be switched off within a week, which is the
lesson `bin/wiki-lint`'s advisory size warnings teach from the other direction.

So this scans **what is about to enter the record**: the working diff against
HEAD, plus untracked files. Material already committed is not re-litigated on
every run — it is already published, and the fix for it is not a gate.

Adapted from `stancsz/second-brain`'s `scripts/ship_gate.py`, which does the
same thing for the same reason.
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Deliberately the same list bin/wiki-skills refuses on, so one vocabulary
# describes a credential shape across the repository. Shapes with a distinctive
# prefix only: a generic 32-hex-character rule would fire on every md5 in
# `log.md` and the gate would be gone by Friday.
PATTERNS = [
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "an AWS access key id"),
    (re.compile(r"\bghp_[A-Za-z0-9]{36}\b"), "a GitHub personal access token"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}"), "a GitHub fine-grained token"),
    (re.compile(r"\bxox[bporas]-[A-Za-z0-9-]{10,}"), "a Slack token"),
    (re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"), "an API secret key"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b"), "a Google API key"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY"), "a private key block"),
]

MAX_UNTRACKED_BYTES = 1_000_000


def git(*args) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True,
                          text=True, encoding="utf-8", errors="replace")


def candidates(staged_only: bool):
    """(label, text) pairs for everything about to enter the record."""
    out = []
    diff = git("diff", "--cached" if staged_only else "HEAD",
               "--no-ext-diff", "--unified=0")
    if diff.returncode != 0:
        return None, "could not read the git diff"
    out.append(("the diff", diff.stdout))
    if staged_only:
        return out, None

    untracked = git("ls-files", "--others", "--exclude-standard", "-z")
    if untracked.returncode != 0:
        return None, "could not enumerate untracked files"
    for rel in filter(None, untracked.stdout.split("\0")):
        path = (ROOT / rel).resolve()
        try:
            path.relative_to(ROOT)
        except ValueError:
            return None, f"untracked path escapes the repository: {rel}"
        try:
            if path.is_file() and path.stat().st_size <= MAX_UNTRACKED_BYTES:
                out.append((rel, path.read_text(encoding="utf-8", errors="ignore")))
        except OSError:
            continue
    return out, None


def scan(staged_only: bool):
    sources, err = candidates(staged_only)
    if err:
        return None, err
    findings = []
    for label, text in sources:
        for pat, why in PATTERNS:
            for m in pat.finditer(text):
                # Never print the value. Six characters is enough to find it and
                # not enough to use it — and this output lands in CI logs.
                findings.append(f"{label}: {why} ({m.group(0)[:6]}…)")
    return sorted(set(findings)), None


def main():
    ap = argparse.ArgumentParser(prog="wiki-secrets",
                                 description=__doc__.split("\n")[0])
    ap.add_argument("cmd", nargs="?", default="check", choices=["check"])
    ap.add_argument("--staged", action="store_true",
                    help="only what git add has staged")
    args = ap.parse_args()

    if not (ROOT / ".git").exists():
        print("wiki-secrets: not a git repository — nothing to scan")
        return 0
    findings, err = scan(args.staged)
    if err:
        print(f"wiki-secrets: {err}", file=sys.stderr)
        return 2
    for f in findings:
        print(f"ERROR {f}")
    scope = "staged changes" if args.staged else "working diff and untracked files"
    print(f"wiki-secrets: {len(findings)} errors, 0 warnings · {scope}")
    if findings:
        print("  This repository is PUBLIC and its history cannot be "
              "un-published.\n  Remove the value and rotate the credential — "
              "do not just delete the line.")
    return 1 if findings else 0


if __name__ == "__main__":
    raise SystemExit(main())
