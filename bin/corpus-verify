#!/usr/bin/env python3
"""Check the corpus on disk against its recorded manifest.

The corpus is gitignored, so git cannot tell you when it has been truncated,
re-exported, or silently replaced with a different vintage. This does that job:
it records size, SHA-256, row count and column set at a known-good moment, and
tells you afterwards whether the file still matches.

Usage:
  bin/corpus-verify            check corpus/messages.csv against the manifest
  bin/corpus-verify --write    (re)record the manifest from the current file

Exit status is 0 when the corpus matches, 1 when it does not, so this can gate
anything that must not run against a corpus that has drifted.
"""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import hashlib
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "corpus" / "messages.csv"
MANIFEST = ROOT / "corpus" / "manifest.json"

csv.field_size_limit(10**9)

SOURCE = {
    "origin": "Apple Messages (chat.db) full export",
    "staged_as": "Google Sheets — 'messages'",
    "sheet_id": "1WxR14bXRcBS6uyrSk4ZVsoyuu9EUE_l6LC3ruaK7ouA",
    "authoritative_from": "2026-09-08",
}


def measure(path: pathlib.Path) -> dict:
    sha = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            sha.update(chunk)
    rows = 0
    with path.open(newline="", encoding="utf-8", errors="replace") as fh:
        reader = csv.reader(fh)
        columns = next(reader, [])
        for _ in reader:
            rows += 1
    return {
        "bytes": path.stat().st_size,
        "sha256": sha.hexdigest(),
        "rows": rows,
        "columns": columns,
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--write", action="store_true",
                    help="record the current corpus as the known-good manifest")
    ap.add_argument("--corpus", type=pathlib.Path, default=CORPUS)
    args = ap.parse_args()

    if not args.corpus.exists():
        print(f"corpus not found: {args.corpus}", file=sys.stderr)
        print("It is gitignored by design — see corpus/README.md to restore it.",
              file=sys.stderr)
        return 1

    actual = measure(args.corpus)

    if args.write:
        MANIFEST.write_text(json.dumps({
            "recorded": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
            "path": str(args.corpus.relative_to(ROOT)),
            "source": SOURCE,
            **actual,
        }, indent=2) + "\n")
        print(f"recorded {actual['rows']:,} rows, {actual['bytes']:,} bytes")
        print(f"  sha256 {actual['sha256']}")
        print(f"  -> {MANIFEST.relative_to(ROOT)}")
        return 0

    if not MANIFEST.exists():
        print(f"no manifest at {MANIFEST.relative_to(ROOT)}; run with --write",
              file=sys.stderr)
        return 1

    expected = json.loads(MANIFEST.read_text())
    problems = []
    for field in ("bytes", "sha256", "rows"):
        if expected.get(field) != actual[field]:
            problems.append(f"  {field}: expected {expected.get(field)}, found {actual[field]}")
    missing = set(expected.get("columns", [])) - set(actual["columns"])
    if missing:
        problems.append(f"  columns missing: {sorted(missing)}")

    if problems:
        print("CORPUS DOES NOT MATCH MANIFEST", file=sys.stderr)
        print("\n".join(problems), file=sys.stderr)
        print(f"\nManifest recorded {expected.get('recorded')}.", file=sys.stderr)
        print("If the corpus was legitimately re-exported, re-run with --write",
              file=sys.stderr)
        print("and re-derive: bin/corpus-stats", file=sys.stderr)
        return 1

    print(f"corpus matches manifest: {actual['rows']:,} rows, "
          f"{len(actual['columns'])} columns")
    print(f"  sha256 {actual['sha256']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
