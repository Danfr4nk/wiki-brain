{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danfr4nk.github.io/wiki-brain/schema/node.schema.json",
  "title": "Wiki Brain node",
  "description": "Common shape for every node. Layer-specific requirements are applied on top of this by the allOf branches at the end. The layer invariant (a node may cite only strictly-lower layers) is NOT expressible in JSON Schema and is enforced by bin/wb-validate.",

  "type": "object",
  "required": ["id", "layer", "type", "title"],
  "additionalProperties": false,

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(src|dat|ent|evt|rel|int|con|pat|syn):[a-z0-9][a-z0-9-]*$",
      "description": "type-prefix:slug. Stable forever — a rename is a new node plus a `supersedes` edge, never an edit."
    },
    "layer": { "type": "integer", "minimum": 0, "maximum": 5 },
    "type": {
      "enum": ["source", "datum", "entity", "event", "relationship",
               "interpretation", "contradiction", "pattern", "synthesis"]
    },
    "title": { "type": "string", "minLength": 1 },

    "confidence": {
      "enum": ["high", "moderate", "low", "speculative", "unknown"],
      "default": "unknown",
      "description": "Should reflect evidence quality, not how plausible a model finds the claim."
    },

    "cites": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeRef" },
      "uniqueItems": true,
      "default": [],
      "description": "The evidence relation. Strictly-lower layers only."
    },

    "edges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["rel", "target"],
        "additionalProperties": false,
        "properties": {
          "rel": {
            "enum": ["caused", "influenced", "contradicted", "preceded", "followed",
                     "depended_on", "resembled", "symbolized", "belonged_to",
                     "occurred_during", "resulted_from", "evidences", "challenges",
                     "supersedes", "participated_in", "located_at", "about"]
          },
          "target": { "$ref": "#/$defs/nodeRef" },
          "note": { "type": "string" },
          "causal_basis": {
            "enum": ["stated", "inferred", "speculative"],
            "description": "Required on `caused`. Sequence is not causation, and the schema refuses to let the two be written identically."
          }
        },
        "allOf": [{
          "if": { "properties": { "rel": { "const": "caused" } }, "required": ["rel"] },
          "then": { "required": ["causal_basis"] }
        }]
      }
    },

    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date":       { "$ref": "#/$defs/date" },
        "approx":     { "type": "string" },
        "start":      { "$ref": "#/$defs/date" },
        "end":        { "$ref": "#/$defs/date" },
        "period":     { "type": "string" },
        "recurrence": { "enum": ["once", "daily", "weekly", "monthly", "yearly", "irregular", "ongoing"] },
        "age":        { "type": "integer", "minimum": 0, "maximum": 130 }
      }
    },

    "importance": {
      "type": "integer", "minimum": 1, "maximum": 5,
      "description": "A mundane event scores high if it explains many later ones."
    },
    "tags":      { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "domains":   { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sensitive": {
      "type": "boolean", "default": false,
      "description": "Excluded from every published artifact. This repository is public."
    },
    "created": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },

    "source_type": {
      "enum": ["conversation", "chat-log", "email", "message-corpus", "audio", "video",
               "transcript", "journal", "document", "photo", "screenshot", "social-media",
               "code", "git-history", "note", "financial", "calendar", "location",
               "playlist", "creative-work", "ai-conversation", "other"]
    },
    "acquired":    { "$ref": "#/$defs/date" },
    "provenance":  { "type": "string", "minLength": 1 },
    "reliability": { "enum": ["primary", "contemporaneous", "corroborated", "retrospective", "third-party", "uncertain"] },
    "location":    { "type": "string" },
    "extraction":  { "type": "string" },

    "claim":     { "type": "string" },
    "subject":   { "$ref": "#/$defs/nodeRef" },

    "entity_kind": {
      "enum": ["person", "family", "institution", "employer", "school", "city",
               "neighborhood", "household", "social-group", "subculture", "movement",
               "political-system", "economic-system", "technology", "media", "period",
               "artifact", "document", "project", "idea", "theory", "belief", "value",
               "trait", "preference", "skill", "other"]
    },

    "perspective": {
      "enum": ["self", "external", "llm", "other"],
      "description": "Self-model, external model and LLM model never silently collapse into one another."
    },
    "persistence": {
      "enum": ["state", "trait", "adaptation", "unknown"],
      "description": "'socially withdrawn', 'low sociability' and 'avoids people after conflict' are three different claims."
    },
    "alternatives": {
      "type": "array", "items": { "type": "string" },
      "description": "Competing explanations left deliberately unresolved."
    },

    "resolved": { "type": "boolean", "default": false },

    "evidence_count": { "type": "integer", "minimum": 0 },
    "counterexamples": {
      "type": "array", "items": { "$ref": "#/$defs/nodeRef" },
      "description": "A pattern that has never looked for its own counterexamples is an anecdote."
    },

    "negative": {
      "enum": ["never_observed", "explicitly_rejected", "known_not_to_occur"],
      "description": "Absence is informative, but these three are not equivalent."
    },

    "supersedes":  { "$ref": "#/$defs/nodeRef" },
    "deprecated":  { "type": "boolean", "default": false },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },

  "$defs": {
    "nodeRef": {
      "type": "string",
      "pattern": "^(src|dat|ent|evt|rel|int|con|pat|syn):[a-z0-9][a-z0-9-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD. Precision is meaningful — do not pad."
    }
  },

  "allOf": [
    {
      "if": { "properties": { "type": { "const": "source" } }, "required": ["type"] },
      "then": {
        "properties": { "layer": { "const": 0 } },
        "required": ["source_type", "provenance", "reliability"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "datum" } }, "required": ["type"] },
      "then": {
        "properties": {
          "layer": { "const": 1 },
          "cites": { "minItems": 1 }
        },
        "required": ["claim", "cites"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "entity" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 2 } }, "required": ["entity_kind"] }
    },
    {
      "if": { "properties": { "type": { "const": "event" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 2 } }, "required": ["when"] }
    },
    {
      "if": { "properties": { "type": { "const": "relationship" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 2 } } }
    },
    {
      "if": { "properties": { "type": { "const": "interpretation" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 3 } }, "required": ["perspective"] }
    },
    {
      "if": { "properties": { "type": { "const": "contradiction" } }, "required": ["type"] },
      "then": {
        "properties": { "layer": { "const": 3 }, "cites": { "minItems": 2 } },
        "required": ["cites"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "pattern" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 4 } }, "required": ["evidence_count"] }
    },
    {
      "if": { "properties": { "type": { "const": "synthesis" } }, "required": ["type"] },
      "then": { "properties": { "layer": { "const": 5 } } }
    }
  ]
}
